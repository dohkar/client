# Скопируйте этот файл в .env.local для локальной разработки

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Запуск только недвижимости (скрыть авто/электронику в UI, редирект URL). true | не задавать
# NEXT_PUBLIC_REAL_ESTATE_ONLY_LAUNCH=true

# Environment
NODE_ENV=development

# Добавьте свои переменные окружения здесь

# DaData: подсказки по адресу и геолокация (маршруты /api/geocode и /api/reverse-geocode в Next.js).
# Ключи из личного кабинета https://dadata.ru/profile/#info
DADATA_API_TOKEN=
# Секретный ключ (часто требуется в заголовке X-Secret для API подсказок)
DADATA_SECRET_KEY=
